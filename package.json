{
  "name": "git-push-sound",
  "displayName": "OmBhatSwaha",
  "description": "Plays the iconic 'Om Phat Swaha' (Tatya Vinchu) sound whenever git push succeeds in the VS Code integrated terminal.",
  "version": "0.0.2",
  "publisher": "devsushant03",
  "repository": {
    "type": "git",
    "url": "https://github.com/DevSushant03/git-push-sound"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:gitPushSound.test",
    "onCommand:gitPushSound.toggle"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "gitPushSound.toggle",
        "title": "Git Push Sound: Toggle Enabled/Disabled"
      },
      {
        "command": "gitPushSound.test",
        "title": "Git Push Sound: Test Sound Playback"
      }
    ],
    "configuration": {
      "title": "Git Push Sound",
      "properties": {
        "gitPushSound.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable sound playback when git push succeeds."
        },
        "gitPushSound.customSoundPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to a custom sound file (.wav recommended). If empty, the bundled 'Om Phat Swaha' sound is used."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node ./scripts/generate-sound.js && tsc -p ./",
    "watch": "node ./scripts/generate-sound.js && tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.93.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
